<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Bidly - Online Auction Platform</display-name>

    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>

    <context-param>
        <param-name>jakarta.faces.STATE_SAVING_METHOD</param-name>
        <param-value>server</param-value>
    </context-param>

    <servlet>
        <servlet-name>FacesServlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
        <multipart-config>
            <max-file-size>52428800</max-file-size>
            <max-request-size>52428800</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>FacesServlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <!-- needs to stay before AuthFilter -->
    <filter>
        <filter-name>BlockedUserFilter</filter-name>
        <filter-class>com.bidly.filter.BlockedUserFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>BlockedUserFilter</filter-name>
        <url-pattern>*.xhtml</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.bidly.filter.AuthFilter</filter-class>
    </filter>
    <!-- pages that need login -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/my-auctions.xhtml</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/my-bids.xhtml</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/create-auction.xhtml</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/notifications.xhtml</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/profile.xhtml</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/watchlist.xhtml</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AdminFilter</filter-name>
        <filter-class>com.bidly.filter.AdminFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- H2 database, stored in ./bidly-data -->
    <data-source>
        <name>java:app/jdbc/BidlyDS</name>
        <class-name>org.h2.jdbcx.JdbcDataSource</class-name>
        <url>jdbc:h2:file:./bidly-data/bidlydb;AUTO_SERVER=TRUE</url>
        <user>sa</user>
        <password></password>
    </data-source>

    <!-- JMS queue for notifications -->
    <jms-connection-factory>
        <name>java:app/jms/BidlyConnectionFactory</name>
        <interface-name>jakarta.jms.ConnectionFactory</interface-name>
    </jms-connection-factory>

    <jms-destination>
        <name>java:app/jms/AuctionEventQueue</name>
        <interface-name>jakarta.jms.Queue</interface-name>
        <destination-name>AuctionEventQueue</destination-name>
    </jms-destination>

    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>404</error-code>
        <location>/error.xhtml</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.xhtml</location>
    </error-page>
</web-app>
